# A full, unmodified, latest upstream yggdrasil-go node — used as the
# "reference client" peer in the black-box test harness so we're validating
# real interop, not just two ydn64 instances talking to themselves.
#
# This node needs a real TUN device (CAP_NET_ADMIN + /dev/net/tun) since,
# unlike ydn64, it has no userspace netstack fallback.
FROM golang:1.25-alpine AS build
RUN apk add --no-cache git
RUN go install github.com/yggdrasil-network/yggdrasil-go/cmd/yggdrasil@latest && \
    go install github.com/yggdrasil-network/yggdrasil-go/cmd/yggdrasilctl@latest
# Test-only helper shared with container A (see test/tools/udpecho): sends and
# receives datagrams of any size, unlike busybox nc whose fixed receive buffer
# truncates below the IPv6 fragmentation threshold. The helper is stdlib-only,
# so it builds against a minimal standalone module instead of the ydn64
# go.mod (which lives outside this build context).
COPY tools /src/tools
WORKDIR /src
RUN printf 'module udpecho\n\ngo 1.25\n' > go.mod && \
    CGO_ENABLED=0 go build -o /out/udpecho ./tools/udpecho

FROM alpine:3.20
# traceroute: exercises NAT64 ICMP error translation from the client side
# (time exceeded / port unreachable handling); tcpdump: asserts on ICMPv6
# Packet Too Big arriving over ygg0 in case 09.
RUN apk add --no-cache ca-certificates bind-tools curl iproute2 tcpdump iputils traceroute
COPY --from=build /go/bin/yggdrasil /go/bin/yggdrasilctl /usr/local/bin/
COPY --from=build /out/udpecho /usr/local/bin/udpecho
COPY yggclient-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
