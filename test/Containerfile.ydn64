# Builds the ydn64 binary under test and packages it into a minimal
# unprivileged image (no TUN/CAP_NET_ADMIN required — that's the whole
# point of ydn64's userspace netstack).
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY src ./src
RUN CGO_ENABLED=0 go build -o /out/ydn64 ./cmd/ydn64
# Test-only helpers (see test/tools/): udpecho is a dependency-free UDP echo
# server for cases that need payloads larger than busybox nc can handle;
# icmperr answers UDP probes with crafted ICMPv4 errors (time exceeded /
# fragmentation needed) so NAT64 ICMP error translation can be tested
# deterministically against loopback instead of real-internet routers.
COPY test/tools ./test/tools
RUN CGO_ENABLED=0 go build -o /out/udpecho ./test/tools/udpecho && \
    CGO_ENABLED=0 go build -o /out/icmperr ./test/tools/icmperr

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /out/ydn64 /usr/local/bin/ydn64
COPY --from=build /out/udpecho /usr/local/bin/udpecho
COPY --from=build /out/icmperr /usr/local/bin/icmperr
ENTRYPOINT ["/usr/local/bin/ydn64"]
